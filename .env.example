# Copy to .env and fill in. Never commit .env.
# Backend base URL. Must be https unless it is localhost.
KBC_API_URL=http://127.0.0.1:3000

# --- stdio mode (default): the customer this AI acts for ---
KBC_USERNAME=lien
KBC_PASSWORD=
# or instead of username/password: a customer token from POST /v1/auth/login (expires after 1h)
# KBC_TOKEN=

# --- http mode ---
# MCP_TRANSPORT=http
# HOST=127.0.0.1
# PORT=3001
# Required when HOST=0.0.0.0 (DNS rebinding protection), e.g. your public hostname
# ALLOWED_HOSTS=kbc-mcp.example.com
